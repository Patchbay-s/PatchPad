# Copier en `.env` (git-ignoré) pour app/scripts/release-macos.sh. Ne jamais committer `.env`.

# --- Developer ID + notarisation
APPLE_SIGNING_IDENTITY="Developer ID Application: Nom (TEAMID)"

# --- Clé API App Store Connect (notarisation)
APPLE_API_ISSUER=
APPLE_API_KEY=
APPLE_API_KEY_PATH=/chemin/vers/AuthKey_XXXXXXXXXX.p8

# --- Ou bien identifiant Apple + mot de passe d'application
# APPLE_ID=
# APPLE_PASSWORD=
# APPLE_TEAM_ID=

# --- Édition Mac App Store (app/scripts/release-appstore.sh)
# « Apple Distribution: Nom (TEAMID) » (signe l'app)
APPLE_DISTRIBUTION_IDENTITY=
# « 3rd Party Mac Developer Installer: Nom (TEAMID) » (signe le .pkg)
APPLE_INSTALLER_IDENTITY=
APPLE_TEAM_ID=
# Profil « Mac App Store Connect » de com.patchbay.patchpad (à garder hors du dépôt)
APPLE_PROVISIONING_PROFILE=/chemin/vers/PatchPad.provisionprofile
# Facultatif : remplace le compteur app/src-tauri/appstore/build-number
BUILD_NUMBER=
